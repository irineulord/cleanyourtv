<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="24dp"
            android:text="@string/settings_personalization" />

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dock_opacity_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="24dp"
            android:text="@string/dock_settings" />

        <TextView
            android:id="@+id/fillDockChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dockTitleChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dockGlassChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dockBandChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dockEvenPaddingChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/singleRowChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dockBandAllChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/alwaysShowNamesChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/icon_size_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/iconSize80" style="@style/SettingsColumnChoice" android:text="80%" />
            <TextView android:id="@+id/iconSize90" style="@style/SettingsColumnChoice" android:text="90%" />
            <TextView android:id="@+id/iconSize100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/iconSize110" style="@style/SettingsColumnChoice" android:text="110%" />
        </LinearLayout>

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/focusOvershootChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/reducedMotionChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="28dp"
            android:text="@string/appearance_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/glass_style_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/glassStyleGlass" style="@style/SettingsColumnChoice" android:text="@string/glass_style_glass" />
            <TextView android:id="@+id/glassStyleRim" style="@style/SettingsColumnChoice" android:text="@string/glass_style_rim" />
            <TextView android:id="@+id/glassStyleHalo" style="@style/SettingsColumnChoice" android:text="@string/glass_style_halo" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/glow_style_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/glowStyleRadial" style="@style/SettingsColumnChoice" android:text="@string/glow_style_radial" />
            <TextView android:id="@+id/glowStyleHorizon" style="@style/SettingsColumnChoice" android:text="@string/glow_style_horizon" />
        </LinearLayout>

        <TextView
            android:id="@+id/cinematicHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/cinematicDotsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/cinematicWhiteFocusChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/cinematic_art_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/cinematicArt0" style="@style/SettingsColumnChoice" android:text="0%" />
            <TextView android:id="@+id/cinematicArt25" style="@style/SettingsColumnChoice" android:text="25%" />
            <TextView android:id="@+id/cinematicArt50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/cinematicArt75" style="@style/SettingsColumnChoice" android:text="75%" />
            <TextView android:id="@+id/cinematicArt100" style="@style/SettingsColumnChoice" android:text="100%" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/cinematic_scrim_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/cinematicScrim0" style="@style/SettingsColumnChoice" android:text="0%" />
            <TextView android:id="@+id/cinematicScrim25" style="@style/SettingsColumnChoice" android:text="25%" />
            <TextView android:id="@+id/cinematicScrim50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/cinematicScrim75" style="@style/SettingsColumnChoice" android:text="75%" />
            <TextView android:id="@+id/cinematicScrim100" style="@style/SettingsColumnChoice" android:text="100%" />
        </LinearLayout>

        <TextView
            android:id="@+id/ambientGlowChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/appGlowChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="28dp"
            android:text="@string/quick_apps" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:id="@+id/installedAppsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/app_library" />

        <TextView
            android:id="@+id/dockChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/dock_edit" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="28dp"
            android:text="@string/settings_screen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dream_name"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
            <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
            <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="28dp"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/wifiChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/wifi" />

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/home_settings" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/tv_settings" />

        <TextView
            android:id="@+id/deviceInfoChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/device_info" />
    </LinearLayout>
</ScrollView>
